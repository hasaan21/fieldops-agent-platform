# --- LLM providers (at least one) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# provider:model string understood by langchain's init_chat_model
FIELDOPS_CHAT_MODEL=openai:gpt-4.1-mini
FIELDOPS_JUDGE_MODEL=openai:gpt-4.1
FIELDOPS_EMBEDDING_MODEL=text-embedding-3-small

# --- LangSmith (tracing, prompt registry, datasets, experiments) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fieldops-dev
# dev | staging | prod: which prompt tag the runtime pulls
FIELDOPS_PROMPT_TAG=dev

# --- Infra (docker compose -f infra/docker-compose.yml up -d) ---
DATABASE_URL=postgresql://fieldops:fieldops@localhost:5433/fieldops
REDIS_URL=redis://localhost:6380/0

# --- Channels ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NYLAS_API_KEY=
NYLAS_GRANT_ID=
NYLAS_WEBHOOK_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- ML / Databricks ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Observability ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
